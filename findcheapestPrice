struct Edge {
    int to;
    int price;
    struct Edge* next;
};

int findCheapestPrice(int n, int** flights, int flightsSize, int* flightsColSize, int src, int dst, int k) {
    // We use a clean dynamic programming (Bellman-Ford variant) approach to avoid large heap structures
    int* dp = (int*)malloc(n * sizeof(int));
    int* temp = (int*)malloc(n * sizeof(int));
    
    for (int i = 0; i < n; i++) {
        dp[i] = 100000000; // Infinity proxy
    }
    dp[src] = 0;

    // Relax edges up to k + 1 times
    for (int i = 0; i <= k; i++) {
        for (int j = 0; j < n; j++) {
            temp[j] = dp[j];
        }
        
        for (int j = 0; j < flightsSize; j++) {
            int u = flights[j][0];
            int v = flights[j][1];
            int w = flights[j][2];
            
            if (dp[u] != 100000000 && dp[u] + w < temp[v]) {
                temp[v] = dp[u] + w;
            }
        }
        
        for (int j = 0; j < n; j++) {
            dp[j] = temp[j];
        }
    }

    int result = dp[dst] == 100000000 ? -1 : dp[dst];
    
    free(dp);
    free(temp);
    
    return result;
}
