// NEW HELPER: Internal function to handle the 1's complement addition math
int calculate_sum(char *s) {
    int n = strlen(s);
    int chunks = n / 8;
    int sum = 0;
    int c, i;

    for (c = 0; c < chunks; c++) {
        int val = 0;
        for (i = 0; i < 8; i++) {
            val = (val << 1) | (s[c * 8 + i] - '0');
        }
        sum = sum + val;
        while (sum > 255) {
            sum = (sum & 255) + 1;
        }
    }
    return sum;
}

int add_checksum(char *t, int raw) {
    char s[4000];
    int n = 0;
    int sum = 0;
    int check = 0;
    int i, b;
    FILE *fp_out;

    for (i = 0; i < 4000; i++) {
        s[i] = 0;
    }

    strcpy(s, t);
    n = strlen(s);
    while (n % 8 != 0) {
        s[n] = '0';
        n++;
    }
    s[n] = '\0';

    printf("\n--- Checksum Generation (8-bit Blocks) ---\n");
    printf("Original Data Stream: ");
    for (i = 0; s[i] != '\0'; i++) {
        printf("%c", s[i]);
        if ((i + 1) % 8 == 0 && s[i + 1] != '\0') printf(" ");
    }
    printf("\n");

    // Calculate sum using helper
    sum = calculate_sum(s);
    check = ~sum & 255;

    printf("Calculated Checksum Segment: ");
    for (b = 7; b >= 0; b--) {
        printf("%d", (check >> b) & 1);
    }

    printf("\nFinal Data to Transmit: %s", s);
    for (b = 7; b >= 0; b--) {
        printf("%d", (check >> b) & 1);
    }
    printf("\n");

    // SENDER WRITES FILE: Automatically writes out to the default intermediate.txt file
    fp_out = fopen("intermediate.txt", "w");
    if (fp_out != NULL) {
        fprintf(fp_out, "%s", s);
        for (b = 7; b >= 0; b--) {
            fprintf(fp_out, "%d", (check >> b) & 1);
        }
        fclose(fp_out);
        printf("Success: Transmitted data saved to 'intermediate.txt'\n");
    } else {
        printf("Error: Could not open 'intermediate.txt' for writing.\n");
    }

    return check;
}

void check_checksum(char *t, int raw) {
    char s[4000];
    int n = 0;
    int sum = 0;
    int final_check = 0;

    strcpy(s, t);
    n = strlen(s);

    if (n % 8 != 0 || n < 16) {
        printf("Error: Stream data must be multiples of 8 bits and include checksum!\n");
        return;
    }

    printf("\n--- Checksum Error Checking ---\n");

    // RECEIVER ONLY READS: Calculate sum directly on file data without triggering a file write
    sum = calculate_sum(s);
    final_check = ~sum & 255;

    // If data + checksum is uncorrupted, the 1's complement sum must be 255 (~255 is 0)
    if (final_check == 0) {
        printf("Result: Checksum Passed! No error detected in data stream.\n");
    } else {
        printf("Result: ERROR DETECTED! Complement total is not zero.\n");
    }
}
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include "head.h"

int main() {
    char s[500];
    int act;
    FILE *fp;
    int i;

    for (i = 0; i < 500; i++) {
        s[i] = 0;
    }

    printf("Select Action:\n1. Add Checksum (Sender)\n2. Check for Error (Receiver)\nChoice: ");
    if (scanf("%d", &act) != 1) {
        printf("Invalid choice.\n");
        return 1;
    }
    getchar(); // Clear trailing newline

    if (act == 1) {
        // Strict binary-only manual input
        printf("Enter raw binary input (0s and 1s only): ");
        if (fgets(s, 500, stdin) == NULL) return 1;
        s[strcspn(s, "\n")] = 0;

        // Input verification for strict binary requirements
        for (i = 0; s[i] != '\0'; i++) {
            if (s[i] != '0' && s[i] != '1') {
                printf("Error: Input must strictly contain only '0' and '1' characters!\n");
                return 1;
            }
        }

        // Run add checksum in raw binary mode
        add_checksum(s, 1);

    } else if (act == 2) {
        // Receiver bypasses console input entirely and reads directly from intermediate.txt
        fp = fopen("intermediate.txt", "r");
        if (fp == NULL) {
            printf("Error: 'intermediate.txt' not found! Run Sender (Action 1) first.\n");
            return 1;
        }

        if (fgets(s, 500, fp) == NULL) {
            printf("Error: 'intermediate.txt' is empty.\n");
            fclose(fp);
            return 1;
        }
        s[strcspn(s, "\n")] = 0;
        fclose(fp);

        printf("Successfully read data from 'intermediate.txt'\n");

        // Error check always treats stream data as a raw binary string
        check_checksum(s, 1);
    } else {
        printf("Invalid action choice.\n");
        return 1;
    }

    return 0;
}
