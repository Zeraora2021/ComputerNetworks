int i,b,j,k;
int global_chunk_size = 8;
static void byte_to_bin_str(unsigned char byte_val, char *out_str) {
    for (b = 7; b >= 0; b--) {
        out_str[7 - b] = ((byte_val >> b) & 1) ? '1' : '0';
    }
    out_str[8] = '\0';
}

void print_polynomial(const char *label, const char *binary_str) {
    int len = strlen(binary_str);
    int first = 1;
    printf("%s: ", label);

    for (i = 0; i < len; i++) {
        if (binary_str[i] == '1') {
            int power = len - 1 - i;
            if (!first) {
                printf(" + ");
            }
            if (power == 0) {
                printf("1");
            } else if (power == 1) {
                printf("x");
            } else {
                printf("x^%d", power);
            }
            first = 0;
        }
    }
    if (first) {
        printf("0");
    }
    printf("\n");
}

void compute_crc16(const char *input_bits, char *fcs_out) {
    int input_len = strlen(input_bits);
    int total_len = input_len + 16;
    char *dividend = (char *)malloc(total_len + 1);

    strcpy(dividend, input_bits);
    for (i = 0; i < 16; i++) {
        dividend[input_len + i] = '0';
    }
    dividend[total_len] = '\0';

    for (i = 0; i <= total_len - 17; i++) {
        if (dividend[i] == '1') {
            for (j = 0; j < 17; j++) {
                dividend[i + j] = (dividend[i + j] == CRC_GEN_POLY[j]) ? '0' : '1';
            }
        }
    }

    strncpy(fcs_out, &dividend[total_len - 16], 16);
    fcs_out[16] = '\0';
    free(dividend);
}

int verify_crc16(const char *frame_bits_with_fcs) {
    int total_len = strlen(frame_bits_with_fcs);
    char *dividend = (char *)malloc(total_len + 1);
    strcpy(dividend, frame_bits_with_fcs);

    for (i = 0; i <= total_len - 17; i++) {
        if (dividend[i] == '1') {
            for (j = 0; j < 17; j++) {
                dividend[i + j] = (dividend[i + j] == CRC_GEN_POLY[j]) ? '0' : '1';
            }
        }
    }

    int has_error = 0;
    for (i = total_len - 16; i < total_len; i++) {
        if (dividend[i] != '0') {
            has_error = 1;
            break;
        }
    }

    free(dividend);
    return has_error;
}

void do_stuffing(char *text, int is_raw_binary) {
    char bits[4000] = {0};
    int bit_count = 0;
    char letter;
    int val, total_bits_len, chunk_start, i, b;
    FILE *out;

    if (is_raw_binary == 1) {
        strncpy(bits, text, sizeof(bits) - 1);
    } else {
        for (i = 0; text[i] != '\0' && bit_count < 3900; i++) {
            letter = text[i];
            for (b = 7; b >= 0; b--) {
                val = (letter >> b) & 1;
                bits[bit_count++] = val ? '1' : '0';
            }
        }
        bits[bit_count] = '\0';
    }

    printf("Converted to binary: %s\n", bits);

    out = fopen("intermediate.txt", "w");
    if (out == NULL) {
        printf("Sorry, couldn't create output file!\n");
        return;
    }

    total_bits_len = strlen(bits);
    chunk_start = 0;

    while (chunk_start < total_bits_len) {
        char current_chunk[4000] = {0};
        int chunk_len = 0;
        char bit_stuffed[8000] = {0};
        int bit_out_len = 0;
        Frame my_frame;

        int ones = 0;
        int prev_was_zero = 0;

        for (i = 0; i < global_chunk_size && (chunk_start + i) < total_bits_len; i++) {
            current_chunk[i] = bits[chunk_start + i];
            chunk_len++;
        }
        current_chunk[chunk_len] = '\0';
        chunk_start += chunk_len;

        printf("\nProcessing chunk (%d bits): %s ---\n", global_chunk_size, current_chunk);

        for (i = 0; current_chunk[i] != '\0'; i++) {
            bit_stuffed[bit_out_len++] = current_chunk[i];
            if (current_chunk[i] == '1') {
                ones++;
                if (ones == 5 && prev_was_zero) {
                    bit_stuffed[bit_out_len++] = '0';
                    ones = 0;
                    prev_was_zero = 0;
                }
            } else {
                ones = 0;
                prev_was_zero = 1;
            }
        }
        bit_stuffed[bit_out_len] = '\0';

        printf(" After bit stuffing: %s\n", bit_stuffed);

        my_frame.flag_start = FLAG;
        my_frame.address = ADDRESS;
        my_frame.control = CONTROL;
        my_frame.flag_end = FLAG;

        char flag_str[9], addr_str[9], ctrl_str[9];
        byte_to_bin_str(my_frame.flag_start, flag_str);
        byte_to_bin_str(my_frame.address, addr_str);
        byte_to_bin_str(my_frame.control, ctrl_str);

        char crc_payload[10000] = {0};
        sprintf(crc_payload, "%s%s%s%s", flag_str, addr_str, ctrl_str, bit_stuffed);

        print_polynomial(" Message Poly", crc_payload);
        printf(" Generator Poly (CRC-16): x^16 + x^15 + x^2 + 1\n");

        compute_crc16(crc_payload, my_frame.fcs_str);
        printf(" Calculated 16-bit FCS: %s\n", my_frame.fcs_str);

        fprintf(out, "%s%s%s%s%s%s\n", flag_str, addr_str, ctrl_str, bit_stuffed, my_frame.fcs_str, flag_str);

        printf(" Frame written: %s %s %s %s %s %s\n",
               flag_str, addr_str, ctrl_str, bit_stuffed, my_frame.fcs_str, flag_str);
    }

    fclose(out);
    printf("\nAll done! Saved frames to 'intermediate.txt'\n");
}

void do_destuffing(void) {
    char clean_bits[16000] = {0};
    int clean_count = 0;
    FILE *fp;
    static char line[64000];
    int i;

    fp = fopen("intermediate.txt", "r");
    if (fp == NULL) {
        printf("Couldn't open 'intermediate.txt'. Run sender first.\n");
        return;
    }

    while (fgets(line, sizeof(line), fp) != NULL) {
        int line_len = strlen(line);
        while (line_len > 0 && (line[line_len - 1] == '\n' || line[line_len - 1] == '\r')) {
            line[line_len - 1] = '\0';
            line_len--;
        }

        int current_pos = 0;
        while (current_pos <= line_len - 8) {

            if (strncmp(&line[current_pos], "01111110", 8) != 0) {
                current_pos++;
                continue;
            }

            int start_pos = current_pos;
            int end_pos = -1;

            for (i = start_pos + 24; i <= line_len - 8; i++) {
                if (strncmp(&line[i], "01111110", 8) == 0) {
                    end_pos = i;
                    break;
                }
            }

            if (end_pos == -1) break;

            int data_start = start_pos + 24;
            int data_end = end_pos - 16;

            char frame_to_check[10000] = {0};
            strncpy(frame_to_check, &line[start_pos], end_pos - start_pos);
            frame_to_check[end_pos - start_pos] = '\0';

            printf("\n--- Receiver Frame Check ---\n");
            print_polynomial(" Received Poly", frame_to_check);

            int crc_error = verify_crc16(frame_to_check);

            if (crc_error) {
                printf(" [CRC ERROR] Remainder non-zero! Frame discarded.\n");
            } else {
                printf(" [CRC OK] Frame valid. De-stuffing...\n");

                char chunk_bits[8000] = {0};
                int chunk_bits_count = 0;
                int ones = 0;
                int prev_was_zero = 0;

                for (i = data_start; i < data_end; i++) {
                    if (line[i] == '0') {
                        if (ones == 5 && prev_was_zero) {
                            ones = 0;
                            prev_was_zero = 0;
                        } else {
                            chunk_bits[chunk_bits_count++] = '0';
                            clean_bits[clean_count++] = '0';
                            ones = 0;
                            prev_was_zero = 1;
                        }
                    } else {
                        chunk_bits[chunk_bits_count++] = '1';
                        clean_bits[clean_count++] = '1';
                        ones++;
                        if (ones == 5 && prev_was_zero) {
                        }
                    }
                }
                chunk_bits[chunk_bits_count] = '\0';
                printf(" De-stuffed chunk: %s\n", chunk_bits);
            }
            current_pos = end_pos + 8;
        }
    }
    fclose(fp);
    clean_bits[clean_count] = '\0';

    printf("\n--- Receiver Frame Output Details ---\n");
    printf("De-stuffed Bit Stream Sequence: %s\n", clean_bits);

    printf("ASCII Characters Decoded output: ");
    for (k = 0; k < clean_count; k += 8) {
        if (k + 8 <= clean_count) {
            char chr = 0;
            for (b = 0; b < 8; b++) {
                chr = (chr << 1) | (clean_bits[k + b] - '0');
            }
            printf("%c", chr);
        }
    }
    printf("\n");
}
