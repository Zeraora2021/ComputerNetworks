#define FLAG    0x7E
#define ADDRESS 0xAA
#define CONTROL 0xFF
#define FCS     0x00000000
#define CRC_GEN_POLY "11000000000000101"

typedef struct {
    unsigned char flag_start;
    unsigned char address;
    unsigned char control;
    unsigned char data;
    unsigned int fcs;
    char fcs_str[17];
    unsigned char flag_end;
} Frame;

