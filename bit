#ifndef BIT_H
#define BIT_H

#include <stdio.h>
#include <string.h>

#define FLAG    0x7E
#define ADDRESS 0xAA
#define CONTROL 0xFF
#define FCS     0x00000000

typedef struct {
    unsigned char flag_start;
    unsigned char address;
    unsigned char control;
    unsigned char data;
    unsigned int fcs;
    unsigned char flag_end;
} Frame;

extern int global_chunk_size;
void do_stuffing(char *text, int is_raw_binary);
void do_destuffing(void);

#endif
#include <stdio.h>
#include <string.h>
#include "bit.h"

int global_chunk_size = 32;

void do_stuffing(char *text, int is_raw_binary) {
    char bits[4000] = {0};
    int bit_count = 0;
    char letter;
    int val, total_bits_len, chunk_start, i, b;
    FILE *out;

    if (is_raw_binary == 1) {
        strncpy(bits, text, sizeof(bits) - 1);
    } else {
        for (i = 0; text[i] != '\0' && bit_count < 3900; i++) {
            letter = text[i];
            for (b = 7; b >= 0; b--) {
                val = (letter >> b) & 1;
                bits[bit_count++] = val ? '1' : '0';
            }
        }
        bits[bit_count] = '\0';
    }

    printf("Total Binary Stream: %s\n", bits);

    out = fopen("intermediate.txt", "w");
    if (out == NULL) {
        printf("Error: Could not save output file!\n");
        return;
    }

    total_bits_len = strlen(bits);
    chunk_start = 0;

    while (chunk_start < total_bits_len) {
        char current_chunk[4000] = {0};
        int chunk_len = 0;
        char bit_stuffed[8000] = {0};
        int bit_out_len = 0;
        Frame my_frame;

        int ones = 0;
        int prev_was_zero = 0;

        for (i = 0; i < global_chunk_size && (chunk_start + i) < total_bits_len; i++) {
            current_chunk[i] = bits[chunk_start + i];
            chunk_len++;
        }
        current_chunk[chunk_len] = '\0';
        chunk_start += chunk_len;

        printf("\nSplitted data (%d bit): ", global_chunk_size);
        for (i = 0; current_chunk[i] != '\0'; i++) {
            printf("%c", current_chunk[i]);
            if ((i + 1) % 8 == 0 && current_chunk[i + 1] != '\0') printf(" ");
        }
        printf(" ---\n");

        for (i = 0; current_chunk[i] != '\0'; i++) {
            bit_stuffed[bit_out_len++] = current_chunk[i];
            if (current_chunk[i] == '1') {
                ones++;
                if (ones == 5 && prev_was_zero) {
                    bit_stuffed[bit_out_len++] = '0';
                    ones = 0;
                    prev_was_zero = 0;
                }
            } else {
                ones = 0;
                prev_was_zero = 1;
            }
        }
        bit_stuffed[bit_out_len] = '\0';

        printf("Bit stuffed          : ");
        for (i = 0; bit_stuffed[i] != '\0'; i++) {
            printf("%c", bit_stuffed[i]);
            if ((i + 1) % 8 == 0 && bit_stuffed[i + 1] != '\0') printf(" ");
        }
        printf("\n");

        my_frame.flag_start = FLAG;
        my_frame.address  = ADDRESS;
        my_frame.control  = CONTROL;
        my_frame.fcs      = FCS;
        my_frame.flag_end = FLAG;

        printf("Framing stored to file: ");
        for (b = 7; b >= 0; b--) { fprintf(out, "%d", (my_frame.flag_start >> b) & 1); printf("%d", (my_frame.flag_start >> b) & 1); }
        printf(" ");
        for (b = 7; b >= 0; b--) { fprintf(out, "%d", (my_frame.address >> b) & 1); printf("%d", (my_frame.address >> b) & 1); }
        printf(" ");
        for (b = 7; b >= 0; b--) { fprintf(out, "%d", (my_frame.control >> b) & 1); printf("%d", (my_frame.control >> b) & 1); }
        printf(" ");
        for (i = 0; bit_stuffed[i] != '\0'; i++) {
            fprintf(out, "%c", bit_stuffed[i]);
            printf("%c", bit_stuffed[i]);
        }
        printf(" ");
        for (b = 31; b >= 0; b--) { fprintf(out, "%d", (my_frame.fcs >> b) & 1); printf("%d", (my_frame.fcs >> b) & 1); }
        printf(" ");
        for (b = 7; b >= 0; b--) { fprintf(out, "%d", (my_frame.flag_end >> b) & 1); printf("%d", (my_frame.flag_end >> b) & 1); }
        printf("\n");
    }

    fclose(out);
    printf("Saved data frames to 'intermediate.txt'\n");
}

void do_destuffing(void) {
    char clean_bits[16000] = {0};
    int clean_count = 0;
    FILE *fp;
    static char line[64000];
    int i, b;

    fp = fopen("intermediate.txt", "r");
    if (fp == NULL) {
        printf("Could not open intermediate.txt\n");
        return;
    }

    if (fgets(line, sizeof(line), fp) != NULL) {
        int line_len = strlen(line);
        while (line_len > 0 && (line[line_len - 1] == '\n' || line[line_len - 1] == '\r')) {
            line[line_len - 1] = '\0';
            line_len--;
        }

        int current_pos = 0;
        while (current_pos <= line_len - 8) {

            if (strncmp(&line[current_pos], "01111110", 8) != 0) {
                current_pos++;
                continue;
            }

            int start_pos = current_pos;
            int end_pos = -1;

            for (i = start_pos + 24; i <= line_len - 8; i++) {
                if (strncmp(&line[i], "01111110", 8) == 0) {
                    end_pos = i;
                    break;
                }
            }

            if (end_pos == -1) {
                break;
            }

            int data_start = start_pos + 24;
            int data_end   = end_pos - 32;

            if (data_start < data_end) {
                printf("\n--- Receiver receiving data ---\n");
                printf("Isolating data from frames: ");
                for (i = data_start; i < data_end; i++) {
                    printf("%c", line[i]);
                    if ((i - data_start + 1) % 8 == 0 && (i + 1) < data_end) printf(" ");
                }
                printf("\n");

                /* Error detection */
                int err_ones = 0;
                int err_prev_zero = 0;
                int has_error = 0;

                for (i = data_start; i < data_end; i++) {
                    if (line[i] == '1') {
                        err_ones++;
                        if (err_ones == 7 && err_prev_zero) {
                            printf("[ERROR DETECTED]: Invalid pattern '0' followed by 7 ones found at position %d!\n", i);
                            has_error = 1;
                            break;
                        }
                    } else {
                        if (err_ones == 5 && err_prev_zero) {
                            err_ones = 0;
                            err_prev_zero = 0;
                        } else {
                            err_ones = 0;
                            err_prev_zero = 1;
                        }
                    }
                }

                /* FIX: Skip de-stuffing if error found */
                if (has_error) {
                    printf("[Frame discarded due to error]\n");
                } else {
                    char chunk_bits[8000] = {0};
                    int chunk_bits_count = 0;
                    int ones = 0;
                    int prev_was_zero = 0;

                    for (i = data_start; i < data_end; i++) {
                        if (line[i] == '0') {
                            if (ones == 5 && prev_was_zero) {
                                ones = 0;
                                prev_was_zero = 0;
                            } else {
                                chunk_bits[chunk_bits_count++] = '0';
                                clean_bits[clean_count++] = '0';
                                ones = 0;
                                prev_was_zero = 1;
                            }
                        } else {
                            chunk_bits[chunk_bits_count++] = '1';
                            clean_bits[clean_count++] = '1';
                            ones++;
                        }
                    }

                    printf("De-stuffed data:            ");
                    for (i = 0; chunk_bits[i] != '\0'; i++) {
                        printf("%c", chunk_bits[i]);
                        if ((i + 1) % 8 == 0 && chunk_bits[i + 1] != '\0') printf(" ");
                    }
                    printf("\n");
                }
            }

            current_pos = end_pos + 8;
        }
    }
    fclose(fp);
    clean_bits[clean_count] = '\0';

    printf("\nFinal received bitstream: %s\n", clean_bits);

    if (clean_count % 8 != 0) {
        printf("Decoded text (Raw Bits Displayed): %s\n", clean_bits);
    } else {
        printf("Decoded text: ");
        for (i = 0; i < clean_count; i += 8) {
            char character = 0;
            if (i + 8 > clean_count) break;
            for (b = 0; b < 8; b++) {
                character = (character << 1) | (clean_bits[i + b] - '0');
            }
            if (character == '\0') break;
            printf("%c", character);
        }
        printf("\n");
    }
}#include "bit.h"

int main() {
    int main_choice;
    int input_type;
    char input_buffer[4000] = {0};


    printf("====================================\n");
    printf("1. Sender (Stuffing & Framing)\n");
    printf("2. Receiver (File Test & Destuffing)\n");
    printf("Select Role: ");
    if (scanf("%d", &main_choice) != 1) return 1;
    getchar();

    if (main_choice == 1) {
        printf("Enter bits per frame payload : ");
        if (scanf("%d", &global_chunk_size) != 1) return 1;
        getchar();

        printf("\n--- Sender Options ---\n");
        printf("1. Convert Console Text String to Frame\n");
        printf("2. Process Raw Bit String Stream directly\n");
        printf("Select Input Mode: ");
        if (scanf("%d", &input_type) != 1) return 1;
        getchar();

        printf("Enter source payload: ");
        if (fgets(input_buffer, sizeof(input_buffer), stdin) == NULL) return 1;
        input_buffer[strcspn(input_buffer, "\n\r")] = '\0';

        do_stuffing(input_buffer, (input_type == 2) ? 1 : 0);

    } else if (main_choice == 2) {
        printf("\nencoded payload stream from 'intermediate.txt'...\n");
        do_destuffing();

    } else {
        printf("Invalid configuration option selected.\n");
    }

    return 0;
}

