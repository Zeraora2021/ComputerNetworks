#define HEAD_H

#include <stdio.h>
#include <stdlib.h>
#include <string.h>

void add_one_dimensional_parity(char *t, int raw);
void check_one_dimensional_parity(char *t, int raw);
void add_two_dimensional_parity(char *t, int raw);
void check_two_dimensional_parity(char *t, int raw);

#endif
#include <stdio.h>
#include <string.h>
#include "head.h"

void add_one_dimensional_parity(char *t, int raw) {
    char s[4000];
    int n = 0;
    int chunks;
    int c;
    int i;
    int ones;
    FILE *fp_out;

    for (i = 0; i < 4000; i++) {
        s[i] = 0;
    }

    strcpy(s, t);
    n = strlen(s);
    while (n % 7 != 0) {
        s[n] = '0';
        n++;
    }
    s[n] = '\0';

    printf("\n--- 1D Odd Parity Addition (7-bit Blocks) ---\n");
    chunks = n / 7;

    // Open intermediate file to construct output stream safely
    fp_out = fopen("intermediate.txt", "w");
    if (fp_out == NULL) {
        printf("Error: Could not open 'intermediate.txt' for writing.\n");
        return;
    }

    printf("Data with Parity: ");
    for (c = 0; c < chunks; c++) {
        ones = 0;
        for (i = 0; i < 7; i++) {
            char k = s[c * 7 + i];
            printf("%c", k);
            fprintf(fp_out, "%c", k); // Write original data bits
            if (k == '1') {
                ones++;
            }
        }

        if (ones % 2 == 0) {
            printf("1");
            fprintf(fp_out, "1"); // Append odd parity bit
        } else {
            printf("0");
            fprintf(fp_out, "0"); // Append odd parity bit
        }

        if (c + 1 < chunks) {
            printf(" ");
        }
    }
    printf("\n");
    fclose(fp_out);
    printf("Success: Transmitted 1D data stream written to 'intermediate.txt'\n");
}

void check_one_dimensional_parity(char *t, int raw) {
    char s[4000];
    int n = 0;
    int chunks;
    int c;
    int i;
    int ones;

    strcpy(s, t);
    n = strlen(s);

    if (n % 8 != 0) {
        printf("Error: Input must be multiples of 8 bits!\n");
        return;
    }

    printf("\n--- 1D Odd Parity Error Checking ---\n");
    chunks = n / 8;

    for (c = 0; c < chunks; c++) {
        ones = 0;
        printf("Block %d [", c + 1);
        for (i = 0; i < 8; i++) {
            char k = s[c * 8 + i];
            printf("%c", k);
            if (k == '1') {
                ones++;
            }
        }

        if (ones % 2 == 1) {
            printf("] -> Passed (Odd count)\n");
        } else {
            printf("] -> ERROR DETECTED! (Even count)\n");
        }
    }
}

void add_two_dimensional_parity(char *t, int raw) {
    char s[4000];
    int n = 0;
    int chunks;
    int row;
    int col[7];
    int c;
    int i;
    int b;
    FILE *fp_out;

    for (i = 0; i < 4000; i++) {
        s[i] = 0;
    }
    for (b = 0; b < 7; b++) {
        col[b] = 0;
    }

    strcpy(s, t);
    n = strlen(s);
    while (n % 7 != 0) {
        s[n] = '0';
        n++;
    }
    s[n] = '\0';

    chunks = n / 7;

    fp_out = fopen("intermediate.txt", "w");
    if (fp_out == NULL) {
        printf("Error: Could not open 'intermediate.txt' for writing.\n");
        return;
    }

    printf("\n--- 2D Odd Parity Grid Generation ---\n");
    printf("7-bit Block | Row Parity Bit\n");
    printf("----------------------------\n");

    for (c = 0; c < chunks; c++) {
        row = 0;
        for (i = 0; i < 7; i++) {
            char k = s[c * 7 + i];
            printf("%c", k);
            fprintf(fp_out, "%c", k); // Stream individual word data bits
            if (k == '1') {
                row++;
                col[i] = col[i] + 1;
            }
        }

        if (row % 2 == 0) {
            printf(" | 1\n");
            fprintf(fp_out, "1"); // Append trailing row-parity bit
        } else {
            printf(" | 0\n");
            fprintf(fp_out, "0"); // Append trailing row-parity bit
        }
    }

    printf("----------------------------\n");
    for (b = 0; b < 7; b++) {
        if (col[b] % 2 == 0) {
            printf("1");
            fprintf(fp_out, "1"); // Append final block parity bit columns
        } else {
            printf("0");
            fprintf(fp_out, "0"); // Append final block parity bit columns
        }
    }
    fprintf(fp_out, "0"); // Final corner bit padding to make column row 8-bits total
    printf("0 (Column Parities with corner bit padding)\n");

    fclose(fp_out);
    printf("Success: Transmitted 2D matrix data stream written to 'intermediate.txt'\n");
}

void check_two_dimensional_parity(char *t, int raw) {
    char s[4000];
    int n = 0;
    int rows;
    int row;
    int col[7];
    int r;
    int c;
    int i;

    int bad_rows[100];
    int bad_cols[7];
    int bad_r_count = 0;
    int bad_c_count = 0;

    char exp;
    char act;

    strcpy(s, t);
    n = strlen(s);

    if (n % 8 != 0) {
        printf("Error: Grid layout mismatch!\n");
        return;
    }

    rows = n / 8;
    for (i = 0; i < 7; i++) {
        col[i] = 0;
        bad_cols[i] = 0;
    }

    printf("\n--- 2D Odd Parity Error Checking ---\n");
    printf("Row Bits | Status\n");
    printf("------------------\n");

    for (r = 0; r < rows - 1; r++) {
        row = 0;
        for (c = 0; c < 8; c++) {
            char k = s[r * 8 + c];
            printf("%c", k);
            if (k == '1') {
                row++;
                if (c < 7) {
                    col[c] = col[c] + 1;
                }
            }
        }

        if (row % 2 == 1) {
            printf(" | Row %d OK\n", r + 1);
        } else {
            printf(" | ROW %d ERROR!\n", r + 1);
            bad_rows[bad_r_count++] = r + 1;
        }
    }

    printf("------------------\n");
    for (c = 0; c < 8; c++) {
        printf("%c", s[(rows - 1) * 8 + c]);
    }
    printf(" | (Stored Column Parity Row)\n");

    for (c = 0; c < 7; c++) {
        if (col[c] % 2 == 0) {
            exp = '1';
        } else {
            exp = '0';
        }

        act = s[(rows - 1) * 8 + c];
        if (exp != act) {
            bad_cols[bad_c_count++] = c + 1;
        }
    }

    printf("\n--- Diagnostic Summary ---\n");
    if (bad_r_count == 0 && bad_c_count == 0) {
        printf("Result: All rows and columns passed successfully!\n");
    } else {
        if (bad_r_count > 0) {
            printf("Failed Row(s): ");
            for (i = 0; i < bad_r_count; i++) {
                printf("Row %d ", bad_rows[i]);
            }
            printf("\n");
        }
        if (bad_c_count > 0) {
            printf("Failed Column(s): ");
            for (i = 0; i < bad_c_count; i++) {
                printf("Column %d ", bad_cols[i]);
            }
            printf("\n");
        }

        if (bad_r_count == 1 && bad_c_count == 1) {
            printf("--> Exact Bit Error Located at: Row %d, Column %d\n", bad_rows[0], bad_cols[0]);
        }
    }
}
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include "head.h"

int main() {
    char s[500];
    int act;
    int par;
    FILE *fp;
    int i;

    for (i = 0; i < 500; i++) {
        s[i] = 0;
    }

    printf("Select Action:\n1. Add Parity (Sender)\n2. Check for Error (Receiver)\nChoice: ");
    if (scanf("%d", &act) != 1) {
        printf("Invalid choice.\n");
        return 1;
    }
    getchar(); // Clear trailing newline

    if (act == 1) {
        // User only provides binary input
        printf("Enter raw binary input (0s and 1s only): ");
        if (fgets(s, 500, stdin) == NULL) return 1;
        s[strcspn(s, "\n")] = 0;

        // Validation rule: Accept binary sequences only
        for (i = 0; s[i] != '\0'; i++) {
            if (s[i] != '0' && s[i] != '1') {
                printf("Error: Input must strictly contain only '0' and '1' characters!\n");
                return 1;
            }
        }

        printf("\nSelect Parity Method:\n1. One Dimensional Parity\n2. Two Dimensional Parity\nChoice: ");
        if (scanf("%d", &par) != 1) return 1;

        if (par == 1) {
            add_one_dimensional_parity(s, 1); // Forcing raw binary mode
        } else if (par == 2) {
            add_two_dimensional_parity(s, 1); // Forcing raw binary mode
        } else {
            printf("Invalid parity choice.\n");
            return 1;
        }

    } else if (act == 2) {
        // Receiver skips console completely and opens intermediate.txt
        fp = fopen("intermediate.txt", "r");
        if (fp == NULL) {
            printf("Error: 'intermediate.txt' not found! Run Sender (Action 1) first.\n");
            return 1;
        }

        if (fgets(s, 500, fp) == NULL) {
            printf("Error: 'intermediate.txt' is empty.\n");
            fclose(fp);
            return 1;
        }
        s[strcspn(s, "\n")] = 0;
        fclose(fp);

        printf("Successfully read transmission data from 'intermediate.txt'\n");

        printf("\nSelect Parity Method for Verification:\n1. One Dimensional Parity\n2. Two Dimensional Parity\nChoice: ");
        if (scanf("%d", &par) != 1) return 1;

        if (par == 1) {
            check_one_dimensional_parity(s, 1);
        } else if (par == 2) {
            check_two_dimensional_parity(s, 1);
        } else {
            printf("Invalid parity choice.\n");
            return 1;
        }
    } else {
        printf("Invalid action choice.\n");
        return 1;
    }

    return 0;
}
